# Keep these SECRET. Do not share your full .env file, screenshots, or logs with tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini free-tier key from https://aistudio.google.com/api-keys
# IMPORTANT: For zero payment, do NOT connect a billing account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

ALERT_MIN_SCORE=1
MAX_ARTICLE_AGE_HOURS=36
MAX_ALERTS_PER_ROUND=20
# Limit AI usage; missing/over-limit AI never stops Telegram news.
MAX_AI_PER_ROUND=8
MAX_AI_PER_DAY=80
LOG_LEVEL=INFO
DATA_DIR=./data
